  "threat_intel": {
    "neptune": {
      "display_name": "Neptune (SYN Flood)",
      "severity": "high",
      "mitre": {
        "technique_id": "T1499.001",
        "technique_name": "Endpoint Denial of Service: OS Exhaustion Flood",
        "tactic": "Impact"
      },
      "description": "A high rate of half-open TCP connections aimed at one host, typical of a SYN-flood resource-exhaustion attack.",
      "recommendation": [
        "Enable SYN cookies on the target host",
        "Rate-limit inbound SYN packets at the perimeter",
        "Inspect firewall/connection-table logs for the source"
      ],
      "red_team": {
        "objective": "Denial of service -- exhaust the target's connection table",
        "common_tools": [
          "hping3",
          "nmap --scan-flags SYN (at volume)"
        ],
        "related_telemetry": [
          "Firewall connection-table exhaustion alerts",
          "Zeek conn.log elevated S0-state ratio"
        ]
      }
    },
    "portsweep": {
      "display_name": "Port Sweep",
      "severity": "medium",
      "mitre": {
        "technique_id": "T1046",
        "technique_name": "Network Service Discovery",
        "tactic": "Discovery"
      },
      "description": "One source touching many distinct ports on a single host in a short window -- reconnaissance to enumerate open services.",
      "recommendation": [
        "Rate-limit or temporarily block the source IP",
        "Review which scanned services are actually meant to be exposed"
      ],
      "red_team": {
        "objective": "Reconnaissance -- enumerate open services",
        "common_tools": [
          "Nmap (-sS/-p-)",
          "Masscan"
        ],
        "related_telemetry": [
